# Disposable development values only. Never use these credentials in production.
COMPOSE_PROJECT_NAME=jungle-gaming
# 5432 is often taken by a local PostgreSQL on developer machines, so the Compose port is 15432.
POSTGRES_PORT=15432
KEYCLOAK_PORT=8081
BROKER_PORT=4566
API_PORT=8080
API_2_PORT=8082
API_3_PORT=8083
DATABASE_URL=postgres://jungle_app:localpassword@localhost:15432/jungle?sslmode=disable
MIGRATION_DATABASE_URL=postgres://jungle:localpassword@localhost:15432/jungle?sslmode=disable
TEST_DATABASE_URL=postgres://jungle_app:localpassword@localhost:15432/jungle_test?sslmode=disable
TEST_MIGRATION_DATABASE_URL=postgres://jungle:localpassword@localhost:15432/jungle_test?sslmode=disable
HTTP_ADDR=:8080
OIDC_ISSUER_URL=http://idp.localhost:8081/realms/jungle
OIDC_AUDIENCE=jungle-backend
AWS_REGION=us-east-1
SQS_ENDPOINT_URL=http://localhost:4566
SQS_INPUT_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_OUTPUT_QUEUE_URL=http://localhost:4566/000000000000/wallet-events.fifo
SQS_INPUT_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_OUTPUT_DLQ_URL=http://localhost:4566/000000000000/wallet-events-dlq.fifo
# Bootstrap writes distinct local IAM keys to .local; scripts load them as needed.
# The default broker (MiniStack, AUTH=true) enforces the identity policies; LocalStack Community (compose.localstack.yaml)
# does not. OIDC authorization of every message remains mandatory either way.
